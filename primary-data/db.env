# Параметры подключения к БД первичных данных (без пароля — он в ~/.pgpass, см. DB.md).
# Подключается в лоадерах: source "$(dirname "$0")/../../db.env"
# Любой параметр можно переопределить из окружения: PGHOST=... ./load.sh
export PGHOST=${PGHOST:-212.26.253.190}
export PGPORT=${PGPORT:-48723}
export PGDATABASE=${PGDATABASE:-106-primary}
export PGUSER=${PGUSER:-team-member}
export PGSSLMODE=${PGSSLMODE:-require}
export PGCONNECT_TIMEOUT=${PGCONNECT_TIMEOUT:-10}

# Keepalive. Путь до БД идёт через проброс порта, и долгая заливка выпадает из
# NAT-таблицы: соединение умирает, а psql виснет в чтении навсегда. 
# В лоадерах: psql "$PGCONN" -w ...
export PGCONN=${PGCONN:-"postgresql:///?keepalives=1&keepalives_idle=30&keepalives_interval=10&keepalives_count=3"}
